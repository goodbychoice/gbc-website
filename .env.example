# サーバー専用。実際の認証情報はコミットせず、NUXT_PUBLIC_も付けない。
NUXT_SUPABASE_URL=https://your-project.supabase.co
NUXT_SUPABASE_SECRET_KEY=sb_secret_replace_me
NUXT_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/replace-me

# VercelでサーバーAPIの接続テストが完了してから有効化する。
# GitHub Pagesの静的配信では/api/contactが使えないため、falseのままにする。
NUXT_PUBLIC_CONTACT_FORM_ENABLED=false
